@echo off
REM ───────────────────────────────────────────────────────────────
REM  station_env.bat  —  프린트 스테이션 공통 환경변수 (이 PC 전용)
REM  ⚠ 절대 깃/웹에 올리지 말 것 (service_role 키 포함)
REM
REM  사용법:
REM   1) 이 파일을 복사해서  station_env.bat  로 이름 변경
REM   2) SUPABASE_SERVICE_KEY 채우기
REM      (Supabase 대시보드 → Project Settings → API → service_role 'secret')
REM      ※ anon 키 아님! service_role(비공개) 키여야 큐 선점/완료가 됨
REM   3) 프린터 2대면 PRINTER_A / PRINTER_B 에 각 프린터 '정확한 이름' 입력
REM      (제어판 → 장치 및 프린터 에 표시되는 이름 그대로)
REM ───────────────────────────────────────────────────────────────

set "SUPABASE_URL=https://zxjhgcumweqaxcemoiga.supabase.co"
set "SUPABASE_SERVICE_KEY=여기에_service_role_키_붙여넣기"

REM ── 프린터 이름 (한 PC에 2대 연결) ──
REM   비워두면 윈도우 '기본 프린터'로 나감(프린터 1대 테스트 시 편함).
REM   2대 운영 시 둘 다 정확한 이름 입력. 예) set "PRINTER_A=Canon G3000 series"
set "PRINTER_A="
set "PRINTER_B="

REM 인쇄 스케일. 기본 noscale(100%%). 여백이 잘리면 fit 로 바꿔도 됨.
set "PRINT_SETTINGS=noscale"
